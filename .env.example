VITE_API_URL=https://amour-bingo-backend.onrender.com/api

# WebSocket URL (optional - will be constructed from API_URL if not provided)
# For local development: http://localhost:10000
# For production: wss://your-backend.com
VITE_WS_URL=

# CDN Configuration (optional)
# Enable CDN for static assets (true/false)
VITE_CDN_ENABLED=false

# CDN Base URL (e.g., https://cdn.jsdelivr.net/gh/yourusername/yourrepo@main/public)
# Or use Cloudflare, AWS CloudFront, etc.
VITE_CDN_BASE_URL=

# CDN Audio Path (relative to CDN base URL)
VITE_CDN_AUDIO_PATH=/sounds