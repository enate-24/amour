# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend URLs (comma-separated for multiple domains)
FRONTEND_URLS=https://your-frontend-domain.netlify.app,https://your-staging-domain.netlify.app,https://your-custom-domain.com

# Optional: Wildcard patterns for dynamic subdomains (use with caution)
# FRONTEND_PATTERNS=https://*.netlify.app,https://*.yourdomain.com

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=30d  # 30 days - prevents token expiration during gameplay

# Database Configuration - Using Render PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database

# Admin Configuration
DEMO_EMAIL=demo@bingo.com
DEMO_PASSWORD=demo123

# Game Configuration
DEFAULT_HOUSE_CUT=25
MAX_BET_AMOUNT=1000
MIN_BET_AMOUNT=1
