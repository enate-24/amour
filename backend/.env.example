# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend URLs (comma-separated for multiple domains)
FRONTEND_URLS=https://your-frontend-domain.netlify.app,https://your-staging-domain.netlify.app,https://your-custom-domain.com

# Optional: Wildcard patterns for dynamic subdomains (use with caution)
# FRONTEND_PATTERNS=https://*.netlify.app,https://*.yourdomain.com

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=30d  # 30 days - prevents token expiration during gameplay

# Database Configuration - Using Aiven PostgreSQL
# Replace with your actual Aiven connection details:
# DATABASE_URL=postgresql://avnadmin:your-password@your-service-name.aivencloud.com:12345/defaultdb?sslmode=require

# Alternative: Individual connection parameters (for local development)
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your-password
# DB_SSL=true

DATABASE_URL=postgresql://username:password@host:port/database

# Admin Configuration
DEMO_EMAIL=demo@bingo.com
DEMO_PASSWORD=demo123

# Game Configuration
DEFAULT_HOUSE_CUT=25
MAX_BET_AMOUNT=1000
MIN_BET_AMOUNT=1
